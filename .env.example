# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# MongoDB connection string (local mongod or an Atlas SRV URI).
# Examples:
#   mongodb://127.0.0.1:27017/palate
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/palate
mongo_url=

# Secret used to sign and verify auth JWTs (jsonwebtoken). Required for
# signup, login, and any route that reads the `token` cookie. Use a long,
# random string, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=

# --- Planned (uncomment as the matching features land) ---

# Transactional email (nodemailer)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# Foursquare Places API key (restaurant data sync)
# FOURSQUARE_API_KEY=
