# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# MongoDB connection string (local mongod or an Atlas SRV URI).
# Examples:
#   mongodb://127.0.0.1:27017/palate
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/palate
mongo_url=

# Secret used to sign and verify auth JWTs (jsonwebtoken). Required for
# signup, login, and any route that reads the `token` cookie. Use a long,
# random string, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=

# --- Transactional email (nodemailer) ---
# Required by lib/mailer.ts. Without these, signup still succeeds but the
# verification mail is logged as failed and the user must use the resend
# endpoint once SMTP is configured.
#
# For local development, ethereal.email generates a throwaway inbox instantly
# ("Create Ethereal Account") and delivers nothing — sendMail logs a preview URL
# to the SERVER terminal instead:
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#
# Gmail needs an App Password (Google Account > Security > App passwords), not
# the account password, and 2-Step Verification must be on:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
SMTP_HOST=
# 465 uses implicit TLS; 587 and 2525 start plaintext and upgrade via STARTTLS.
# lib/mailer.ts derives `secure` from this value, so the two cannot disagree.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# A bare address, no display name — the "Palate" label is added in code.
# Quoting rules for env files are inconsistent, so `"Palate" <a@b.com>` here can
# silently parse as just `Palate`. Must be an address the SMTP account may send
# as, or the mail lands in spam (or is rejected outright).
MAIL_FROM=

# Origin used to build absolute links in outgoing email (verification, and the
# reservation confirmation). No NEXT_PUBLIC_ prefix: only the server builds
# these, and NEXT_PUBLIC_ values are inlined into the browser bundle.
#   http://localhost:3000 in development
APP_URL=

# Foursquare Places API key (restaurant data sync)
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=

# Base URL of the FastAPI recommender (restarunt-Rec/service.py).
#
# Read by the nearby route, the group shortlist route, and the re-embed call in
# lib/applyReviewToRestaurant.ts. All three fall back to http://localhost:8000,
# which is right in development and wrong everywhere else — and the two failure
# modes are opposite, so an unset value in production is not obvious from one
# screen. `nearby` catches the error and quietly serves an unranked list, while
# the group shortlist returns 503 and the vote cannot start at all.
#
#   http://localhost:8000 in development
RECOMMENDER_URL=

# --- Distributed rate limiting (optional in development, REQUIRED in prod) ---
# lib/rateLimit.ts keeps its counters in Redis when these are set, and in this
# process's memory when they are not.
#
# In-memory is correct for a single Node instance and silently wrong for any
# number greater than one: with three instances behind a load balancer a
# "10 per 15 minutes" rule becomes thirty. On serverless it is worse, because
# each invocation may get a fresh isolate, so the counters reset constantly and
# the limiter does nothing at all while still looking correct.
#
# Create a free database at console.upstash.com and copy the REST url and token
# (not the redis:// connection string — this uses the HTTP API so it works from
# a serverless isolate that cannot hold a socket open).
#
# Leave both blank in development; the Map is the right store on one machine.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the recommender's write endpoint (POST /index/missing).
# Must match RECOMMENDER_TOKEN in restarunt-Rec. Generate with
# `openssl rand -hex 32`. Sent by lib/recommender.ts as x-recommender-token.
#
# Leave blank in development: the service leaves the endpoint open when it has
# no token, and logs a warning saying so at startup. On any reachable host set
# both sides, or indexing silently 401s and new restaurants never get vectors.
RECOMMENDER_TOKEN=
