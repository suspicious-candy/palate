# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# MongoDB connection string (local mongod or an Atlas SRV URI).
# Examples:
#   mongodb://127.0.0.1:27017/palate
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/palate
mongo_url=

# Secret used to sign and verify auth JWTs (jsonwebtoken). Required for
# signup, login, and any route that reads the `token` cookie. Use a long,
# random string, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=

# --- Transactional email (nodemailer) ---
# Required by lib/mailer.ts. Without these, signup still succeeds but the
# verification mail is logged as failed and the user must use the resend
# endpoint once SMTP is configured.
#
# For local development, ethereal.email generates a throwaway inbox instantly
# ("Create Ethereal Account") and delivers nothing — sendMail logs a preview URL
# to the SERVER terminal instead:
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#
# Gmail needs an App Password (Google Account > Security > App passwords), not
# the account password, and 2-Step Verification must be on:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
SMTP_HOST=
# 465 uses implicit TLS; 587 and 2525 start plaintext and upgrade via STARTTLS.
# lib/mailer.ts derives `secure` from this value, so the two cannot disagree.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# A bare address, no display name — the "Palate" label is added in code.
# Quoting rules for env files are inconsistent, so `"Palate" <a@b.com>` here can
# silently parse as just `Palate`. Must be an address the SMTP account may send
# as, or the mail lands in spam (or is rejected outright).
MAIL_FROM=

# Origin used to build absolute links in outgoing email (verification, and the
# reservation confirmation). No NEXT_PUBLIC_ prefix: only the server builds
# these, and NEXT_PUBLIC_ values are inlined into the browser bundle.
#   http://localhost:3000 in development
APP_URL=

# Foursquare Places API key (restaurant data sync)
FOURSQUARE_API_KEY=
FOURSQUARE_API_VERSION=
